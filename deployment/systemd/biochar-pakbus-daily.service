[Unit]
Description=Biochar daily PakBus diagnostic and logger download
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/biocharWaterConserveWebsite
EnvironmentFile=/etc/biochar/pipeline.env
ExecStart=/home/ubuntu/biocharWaterConserveWebsite/.venv/bin/python -m biochar_app.pakbus.core.daily_download

ProtectSystem=strict
ReadWritePaths=/home/ubuntu/biocharWaterConserveWebsite/biochar_app/data-raw /home/ubuntu/biocharWaterConserveWebsite/biochar_app/data-processed
PrivateTmp=true
NoNewPrivileges=true
