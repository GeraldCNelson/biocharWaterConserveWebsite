{
  "schema_version": 1,
  "bucket": "biochar-research-backup-gcn2026",
  "region": "us-east-2",
  "destination_prefix": "biocharWaterConserveWebsite",
  "global_excludes": [
    ".DS_Store",
    "*/.DS_Store",
    "__pycache__/*",
    "*/__pycache__/*",
    "*.pyc",
    ".env",
    ".env.*",
    "*/.env",
    "*/.env.*",
    "*.pem",
    "*.key"
  ],
  "sources": [
    {
      "path": "biochar_app/data-raw",
      "required_on_acquisition_server": true,
      "excludes": [
        "datfiles_2026/COM3 Monitoring Session.spm",
        "datfiles_2026/Fruita router.txt",
        "datfiles_2026/IL vpn.txt",
        "datfiles_2026/netgearInfo.txt",
        "datfiles_2026/PC400.bkp",
        "datfiles_2026/PC400.zip.txt",
        "datfiles_2026/logs/*",
        "datfiles_2026/manuals/*",
        "datfiles_2026/python3/*",
        "datfiles_2026/sys/inifiles/*",
        "spm_sessions/*",
        "temp holder/*"
      ],
      "description": "Workbook, logger, PakBus, laboratory, field-mapping, and related source evidence"
    },
    {
      "path": "biochar_app/data-processed/management/irrigation/photos",
      "required_on_acquisition_server": false,
      "excludes": [],
      "description": "Original irrigation meter photographs and their review records"
    },
    {
      "path": "biochar_app/geospatial/drone",
      "required_on_acquisition_server": false,
      "excludes": [],
      "description": "Drone imagery, video, flight data, and capture metadata"
    },
    {
      "path": "biochar_app/geospatial/qgis",
      "required_on_acquisition_server": false,
      "excludes": [],
      "description": "Manually developed QGIS project material"
    }
  ]
}
